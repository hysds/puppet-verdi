# syntax = docker/dockerfile:1.0-experimental
ARG TAG=v5.2.1.1
FROM hysds/dev:${TAG}

# Get org and branch
ARG ORG
ARG BRANCH
ARG FRAMEWORK_BRANCH
ARG BASE_BRANCH
ARG HYSDS_RELEASE=v5.2.1

# Set git URL and version
ENV GIT_URL https://github.com/${ORG}/puppet-verdi/raw/${BRANCH}/install.sh

# Add version.json to invalidate cache when the branch changes
ADD https://api.github.com/repos/${ORG}/puppet-verdi/git/refs/heads/${BRANCH} version.json

# Install dependencies and setup common configuration, only if the git URL changes
RUN --mount=type=secret,id=git_oauth_token \
    set -ex \
    && sudo cp /run/secrets/git_oauth_token $HOME/.git_oauth_token \
    && sudo chown ops:ops $HOME/.git_oauth_token \
    && sudo dnf update -y \
    && sudo curl -skL ${GIT_URL} > /tmp/install.sh \
    && sudo chmod 755 /tmp/install.sh \
    && sudo /tmp/install.sh ${ORG} ${BRANCH} ${BASE_BRANCH} \
    && sudo rm -rf /etc/puppetlabs/code/modules/* /mnt/swapfile \
    && sudo dnf clean all \
    && sudo rm -f /tmp/install.sh \
    && sudo rm -rf /var/cache/dnf \
    && cd $HOME \
    && ./install_hysds.sh ${FRAMEWORK_BRANCH} ${HYSDS_RELEASE} \
    && rm -rf $HOME/verdi/ops/*/.git* \
    && rm -rf $HOME/.cache \
    && rm -rf $HOME/.git_oauth_token

# Switch to a cleaner base image
FROM hysds/base:${TAG}

# Get org and branch
ARG ORG
ARG BRANCH
ARG BASE_BRANCH

# Set git URL for puppet module
ENV GIT_URL https://github.com/${ORG}/puppet-verdi/raw/${BRANCH}/install.sh

# Install the base image dependencies only when the git URL changes
RUN set -ex \
    && sudo curl -skL ${GIT_URL} > /tmp/install.sh \
    && sudo chmod 755 /tmp/install.sh \
    && sudo /tmp/install.sh ${ORG} ${BRANCH} ${BASE_BRANCH} \
    && sudo rm -rf /etc/puppetlabs/code/modules/* /mnt/swapfile \
    && sudo dnf clean all \
    && sudo rm -f /tmp/install.sh \
    && sudo rm -rf /var/cache/dnf

# Copy ops home from the build stage
COPY --chown=ops:ops --from=0 /home/ops /home/ops

# Set entrypoint
COPY docker/entrypoint* /
ENTRYPOINT ["/entrypoint-pge.sh"]
CMD ["/bin/bash", "--login"]